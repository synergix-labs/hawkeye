AppEvents
| where Properties.EventId == 4771
| extend TargetUserName_ = tostring(Properties.TargetUserName)
| extend Client_Address_ = tostring(Properties.["Client Address"])
| extend Failure_Code_ = tostring(Properties.["Failure Code"])
| where Properties.["Failure Code"] == 0x18
// Exclude machine accounts
| where TargetUserName_ !endswith "$"
| summarize 
    AttemptCount = count(),
    DistinctAccounts = dcount(TargetUserName_),
    AccountsList = make_set(TargetUserName_, 50)
    by Client_Address_, bin(TimeGenerated, 5m)
// Detection threshold tuning
| where DistinctAccounts >= 10 and AttemptCount >= 20
| order by AttemptCount desc

